{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./src/*"],
      "@t3tools/client-runtime": ["../../packages/client-runtime/src/index.ts"],
      "@t3tools/contracts": ["../../packages/contracts/src/index.ts"],
      "@t3tools/contracts/*": ["../../packages/contracts/src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["@effect/platform-node"],
        "diagnosticSeverity": {
          "importFromBarrel": "error",
          "anyUnknownInErrorContext": "warning",
          "instanceOfSchema": "warning",
          "deterministicKeys": "warning"
        }
      }
    ]
  },
  "include": [
    "src",
    "vite.config.ts",
    "test",
    "../../packages/client-runtime/src",
    "../../packages/contracts/src"
  ]
}
